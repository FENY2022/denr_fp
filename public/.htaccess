Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Preserve Authorization for the RED workstation Bearer token on XAMPP/Apache.
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

  # Leave physical public assets and the front controller untouched.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Human-friendly paths; route names are validated by index.php.
  RewriteRule ^([a-z][a-z0-9-]*)/?$ index.php?page=$1 [QSA,END,NC]
</IfModule>
