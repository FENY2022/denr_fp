APP_NAME="DENR FP-OMS"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=denr_fp_oms
DB_USERNAME=fp_oms_user
DB_PASSWORD=replace_with_strong_password
SESSION_NAME=denr_fp_oms_session
MAX_UPLOAD_BYTES=5242880

# Required only for one-time web creation of the first RICTU Super Administrator.
# Set a long random secret before opening /setup-admin, then remove/rotate it after setup.
FPOMS_SETUP_KEY=replace_with_long_random_one_time_setup_key

# Optional: prefill the first RICTU Super Administrator identity on /setup-admin.
# Keep actual deployment values only in the server .env, not in source control.
FPOMS_ADMIN_NAME=
FPOMS_ADMIN_EMAIL=

# Password reset and applicant registration/decision emails use the same PHPMailer SMTP transport.
# Gmail SMTP uses STARTTLS on port 587. Keep the real Gmail App Password only
# in the server .env; never commit it to GitHub.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME="DENR FP-OMS"
MAIL_FROM_ADDRESS=your-gmail-account@gmail.com
MAIL_VERIFY_PEER=true
MAIL_TIMEOUT=20
MAIL_DEBUG=false
