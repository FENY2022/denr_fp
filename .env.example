APP_NAME="DENR FP-OMS"
APP_ENV=local
APP_DEBUG=false
# Email links use APP_URL exactly: use the externally reachable HTTPS site URL for reviewers.
# This HTTP loopback default is ONLY for testing on the same computer running FP-OMS.
# If the app runs in a subfolder, include that path (for example: http://localhost/denr_fp/public).
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=denr_fp_oms
DB_USERNAME=fp_oms_user
DB_PASSWORD=replace_with_strong_password
SESSION_NAME=denr_fp_oms_session
MAX_UPLOAD_BYTES=5242880

# Required only for one-time web creation of the first RICTU Super Administrator.
# Set a long random secret before opening /setup-admin, then remove/rotate it after setup.
FPOMS_SETUP_KEY=replace_with_long_random_one_time_setup_key

# Optional: prefill the first RICTU Super Administrator identity on /setup-admin.
# Keep actual deployment values only in the server .env, not in source control.
FPOMS_ADMIN_NAME=
FPOMS_ADMIN_EMAIL=

# Password reset and applicant registration/decision emails use the same PHPMailer SMTP transport.
# Gmail SMTP uses STARTTLS on port 587. Keep the real Gmail App Password only
# in the server .env; never commit it to GitHub.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME="DENR FP-OMS"
MAIL_FROM_ADDRESS=your-gmail-account@gmail.com
MAIL_VERIFY_PEER=true
MAIL_TIMEOUT=20
MAIL_DEBUG=false

# Optional: 32+ character random secret for 24-hour signed LPDD-FUS reviewer email-prefill links.
# Set only in the deployed server .env; without it, reviewer login requires manual email entry.
FPOMS_REVIEW_LINK_KEY=

# FP-OMS automatically generates and persists the 256-bit file encryption key.
# No encryption secret needs to be entered in .env or uploaded to GitHub.
# Optional ONLY if PHP cannot create a private key directory outside the webroot:
# FPOMS_KEY_DIR=C:/xampp/fpoms-secure-keys
# IMPORTANT: Never set FPOMS_KEY_DIR inside htdocs or a public web directory.

# Legacy OPTIONAL Pusher configuration. Normally use Super Admin →
# Configuration → Realtime Notifications and Save Settings inside FP-OMS.
# No manual .env change is needed for Pusher. Saved DB settings override
# these legacy fields, even if disabled.
# Rotate any previously shared secret; never commit credentials to GitHub.
# Database notifications work even when Pusher is disabled/unavailable.
PUSHER_ENABLED=false
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# FP-OMS ↔ PNPKI_2 cross-system signing/release. Both systems require migration.
# Server-to-server only; NEVER store PNPKI .p12 / private keys / PIN in FP-OMS.
# Set the exact PNPKI_2 endpoint. Use https in production.
PNPKI_BRIDGE_URL=
# Same random 64+ character secret as PNPKI_2 fpoms_bridge_config.local.php
PNPKI_BRIDGE_SECRET=
# ONLY for both systems on the same localhost XAMPP installation.
PNPKI_BRIDGE_ALLOW_LOCAL_HTTP=false
